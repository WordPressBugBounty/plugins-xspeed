{
  "name": "wpdeveloper/xspeed",
  "description": "xSpeed — minimal, ultra-fast WordPress caching plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "matthiasmullie/minify": "^1.3"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "XSpeed\\Modules\\": "includes/modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "XSpeed\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
