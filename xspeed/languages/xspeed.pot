#: includes/modules/Bloat/BloatModule.php:74
msgid "Disable XML-RPC"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:75
msgid "Turns off the old xmlrpc.php file that attackers often target. Leave this off if you use Jetpack or the WordPress mobile app."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:80
msgid "Remove jQuery Migrate"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:81
msgid "Removes a script that old themes and plugins need, from pages visitors see. Saves about 10 KB and is safe on current themes."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:86
msgid "Remove editor styles for visitors"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:87
msgid "Removes block editor CSS that some plugins load on public pages by mistake, which can add hundreds of KB. Block styles for visitors stay."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:92
msgid "Remove RSD link"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:93
msgid "Drop the Really Simple Discovery link from the page head. Only old desktop blogging clients read it."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:98
msgid "Remove shortlink"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:99
msgid "Drop the ?p=123 shortlink tag and header from posts and pages. The shortlinks keep working; they are just no longer advertised."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:104
msgid "Remove REST API links"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:105
msgid "Drop the /wp-json/ discovery link tag and Link header. The REST API itself stays on; to block it, use the setting below."
msgstr ""

#: includes/modules/Bloat/BloatModule.php:110
msgid "Hide WordPress version"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:111
