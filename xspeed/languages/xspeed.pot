#: includes/modules/Bloat/BloatModule.php:68
msgid "Disable RSS feeds"
msgstr ""

#: includes/modules/Bloat/BloatModule.php:69
msgid "Feed addresses such as /feed/ return \"not found\". Use this if your site has no feed readers."
